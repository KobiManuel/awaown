# Base URL of the AwaOwn API (the NestJS app in backend/).
# Local dev: the API runs on :3001 with a global /api prefix.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Public URL of the site (SEO canonical / OpenGraph on product pages).
NEXT_PUBLIC_SITE_URL=https://awaown.com

# Paystack public key (pk_test_… / pk_live_…). Optional. The inline popup
# resumes a server-created transaction and doesn't need it.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Google Analytics 4 Measurement ID (looks like "G-XXXXXXXXXX"), from a GA4
# property you create at analytics.google.com. Optional - tracking is a
# no-op (no script even loads) until this is set. Tracks the marketing site
# and every customer/merchant/partner dashboard, never /admin.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta Pixel ID, from Meta Events Manager (Business Manager > Events Manager >
# your pixel > Settings). Optional - same no-op-until-set behaviour and the
# same site coverage as the GA id above. Fires PageView on every route change
# plus ViewContent/AddToCart/InitiateCheckout/Purchase from the relevant pages.
NEXT_PUBLIC_META_PIXEL_ID=
